# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.migration
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scraper output (regenerated by `npm run scrape`)
/scripts/scraper/output/

# generated from a live scrape by `npm run scrape:sql` (2 MB, changes wholesale each run)
/supabase/scraped-catalogue.sql

# point-in-time database snapshots are local recovery artifacts
/backups/backup-*.json
/backups/supabase-migration-*/
/backups/supabase-storage-failures-*.json

# generated by the project-scoped Supabase CLI
/supabase/.temp/
