# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.venv-watermarks/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.migration
.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scraper output (regenerated by `npm run scrape`)
/scripts/scraper/output/
/scripts/guides/output/

# generated from a live scrape by `npm run scrape:sql` (2 MB, changes wholesale each run)
/supabase/scraped-catalogue.sql

# point-in-time database snapshots are local recovery artifacts
/backups/backup-*.json
/backups/supabase-migration-*/
/backups/supabase-storage-failures-*.json

# generated by the project-scoped Supabase CLI
/supabase/.temp/

# Playwright: run artifacts, not results worth keeping. The specs are the
# record; a trace is for the failure that produced it.
/e2e/.results/
/e2e/.report/
/test-results/
/playwright-report/
/.playwright/

# Performance runs. The *baselines* under perf/ are committed and are the whole
# point; a single run's output is not.
/perf/latest.json
/perf/nightly.json
/perf/*-run.json
