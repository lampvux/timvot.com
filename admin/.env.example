# Shared with the public Shuttlecraft website. Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Required for creating and disabling staff Auth users.
SUPABASE_SERVICE_ROLE_KEY=

# Used only by `npm run bootstrap:admin`; never exposed to the browser.
ADMIN_INITIAL_EMAIL=owner@example.com
ADMIN_INITIAL_PASSWORD=replace-with-a-long-unique-password
ADMIN_INITIAL_NAME=Shuttlecraft Owner

# Public storefront cache endpoint. Optional, but recommended so edits appear
# immediately instead of waiting for the storefront cache window.
STOREFRONT_REVALIDATE_URL=https://your-storefront.vercel.app/api/revalidate
STOREFRONT_REVALIDATE_SECRET=

# Optional upload bucket override. The migration creates `racket-images`.
SUPABASE_IMAGE_BUCKET=racket-images
