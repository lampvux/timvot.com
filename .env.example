# ---------------------------------------------------------------- Supabase
# Project Settings → API.
# Without these the app still runs, on the seeded catalogue in
# src/lib/data/seed.ts. Auth surfaces (watchlist, price alerts, reviews) say so
# plainly rather than pretending to work.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy key name, still accepted:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=


# ------------------------------------------------------------------- Auth
# Where OAuth comes back to. This must match, exactly, the "Site URL" in
# Supabase → Authentication → URL Configuration, and the redirect URI you
# register with Google and Facebook. It cannot be inferred from the request
# host: doing so would let any host that reaches the app mint a redirect target.
#
# Local development:  http://localhost:3000
# Production:         https://your-domain.com
# On Vercel this falls back to the deployment URL, so it is only required when
# you have a custom domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Social sign-in buttons to render, comma separated. Supported: google, facebook.
# Leave empty for email-and-password only.
#
# This ONLY controls the UI. A provider must also be enabled in
# Supabase → Authentication → Providers, or the button will send people out and
# bounce them back with an error. Turn both on together.
# See docs/auth-setup.md for the full walkthrough.
NEXT_PUBLIC_AUTH_PROVIDERS=

# The provider secrets themselves are NOT read by this app — they are stored in
# the Supabase dashboard, which is what talks to Google and Facebook. They are
# listed here only so you know what to collect:
#
#   Google    Client ID + Client secret   console.cloud.google.com → Credentials
#   Facebook  App ID + App secret         developers.facebook.com → App settings


# -------------------------------------------------------------- Migrations
# scripts/migrate.ts needs DDL access, which the publishable and service-role
# keys cannot provide. Either of these works; DIRECT_URL is preferred.
#
# DIRECT_URL is the session-mode connection (port 5432). DATABASE_URL is the
# transaction-mode pooler (6543, pgbouncer=true), which cannot run DDL reliably.
# DIRECT_URL=postgresql://postgres.<ref>:PASSWORD@<region>.pooler.supabase.com:5432/postgres
# DATABASE_URL=postgresql://postgres.<ref>:PASSWORD@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# SUPABASE_ACCESS_TOKEN=sbp_...          Dashboard → Account → Access Tokens


# ------------------------------------------------------------------ Scraper
# Writing the scraped catalogue with `npm run scrape:sync`. Catalogue writes are
# admin-only under RLS, so the publishable key is rejected.
# SUPABASE_SERVICE_ROLE_KEY=...          Dashboard → Settings → API

# Manufacturer gallery crawl (npm run scrape:images). Uses the same service
# role key as the catalogue sync — Storage writes and racket_images writes are
# both admin-only under RLS. Optional: override the bucket name.
# SUPABASE_IMAGE_BUCKET=racket-images

# --- Cache revalidation (optional) ---------------------------------------
# Lets `npm run scrape:sync` publish a price change immediately instead of
# waiting out the cacheLife window in next.config.ts. Set both, with the same
# secret on the deployment and on whatever machine runs the scraper. Leave
# unset for local runs: the scraper says so and carries on.
REVALIDATE_URL=https://your-app.vercel.app/api/revalidate
REVALIDATE_SECRET=
