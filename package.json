{
  "name": "shuttlecraft",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "@swc/core@1.16.0": true,
    "esbuild@0.28.2": true
  },
  "scripts": {
    "dev": "next dev",
    "guides:generate": "node --import ./scripts/guides/typescript-loader.mjs scripts/guides/index.ts",
    "guides:daily": "node --import ./scripts/guides/typescript-loader.mjs scripts/guides/index.ts --daily",
    "guides:check": "node --import ./scripts/guides/typescript-loader.mjs scripts/guides/index.ts --check",
    "guides:models": "node --import ./scripts/guides/typescript-loader.mjs scripts/guides/index.ts --models",
    "guides:research": "node --import ./scripts/guides/typescript-loader.mjs scripts/guides/index.ts --research-only",
    "guides:revalidate": "node --import ./scripts/guides/typescript-loader.mjs scripts/guides/index.ts --revalidate",
    "guides:repair-vi": "node --import ./scripts/guides/typescript-loader.mjs scripts/guides/repair-vietnamese.ts",
    "guides:schedule": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/guides/schedule.ps1",
    "test:guides": "node --import ./scripts/guides/typescript-loader.mjs --test scripts/guides/*.test.ts src/lib/guides/*.test.ts",
    "build": "node --max-old-space-size=6144 ./node_modules/next/dist/bin/next build",
    "start": "next start",
    "seed:sql": "tsx scripts/generate-seed.ts",
    "seed:db": "tsx scripts/seed-db.ts",
    "scrape": "tsx scripts/scraper/index.ts",
    "backup": "tsx scripts/backup.ts",
    "restore": "tsx scripts/restore.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:lib && npm run test:security && npm run test:scraper && npm run test:image-scraper && npm run test:string-scraper && npm run test:catalogue && npm run test:supabase-migration",
    "test:guardrails": "tsx --test src/lib/guardrails/*.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --project=dev-smoke --workers=1",
    "test:security": "tsx --conditions=react-server --test scripts/security/*.test.ts",
    "test:rls": "tsx --conditions=react-server --test scripts/security/rls/*.test.ts",
    "perf:budget": "tsx scripts/perf-budget.ts",
    "perf:routes": "tsx scripts/route-report.ts",
    "test:lib": "tsx --test src/lib/*.test.ts src/lib/**/*.test.ts src/i18n/*.test.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "scrape:quick": "tsx scripts/scraper/index.ts --pages=3 --no-verify",
    "scrape:verify": "tsx scripts/scraper/index.ts --sample=8",
    "scrape:sync": "tsx scripts/scraper/index.ts --sync-db",
    "scrape:refresh": "tsx scripts/scraper/index.ts --no-verify --sync-db",
    "market:refresh": "tsx scripts/refresh-market.ts",
    "warm": "tsx scripts/warm-routes.ts",
    "audit:glyphs": "tsx scripts/audit-font-glyphs.ts",
    "scrape:sql": "tsx scripts/scraper/generate-sql.ts",
    "test:scraper": "tsx --test scripts/scraper/*.test.ts scripts/scraper/sites/*.test.ts",
    "scrape:strings": "tsx scripts/string-scraper/index.ts",
    "scrape:strings:sync": "tsx scripts/string-scraper/index.ts --sync-db",
    "test:string-scraper": "tsx --test scripts/string-scraper/*.test.ts",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:dry": "tsx scripts/migrate.ts --dry-run",
    "supabase:migrate": "tsx scripts/migrate-supabase-project.ts",
    "test:supabase-migration": "tsx --test scripts/migrate-supabase-project.test.ts",
    "scrape:images": "tsx scripts/scraper/images/index.ts",
    "scrape:images:retailers": "tsx scripts/scraper/images/retailer-backfill.ts",
    "images:watermark": "tsx scripts/scraper/images/remove-watermarks.ts",
    "images:undo-run": "tsx scripts/scraper/images/undo-backfill-run.ts",
    "watermark:up": "docker compose up -d --build watermark",
    "watermark:down": "docker compose down watermark",
    "test:watermark-service": "docker compose run --rm --no-deps watermark python -m unittest -v test_detect",
    "scrape:images:dry": "tsx scripts/scraper/images/index.ts --dry-run --from-file",
    "test:image-scraper": "tsx --test scripts/scraper/images/*.test.ts",
    "images:audit": "tsx scripts/scraper/images/audit.ts",
    "images:thumbs": "tsx scripts/scraper/images/backfill-thumbnails.ts",
    "images:cache-repair": "tsx scripts/scraper/images/repair-cache-control.ts",
    "images:reconcile": "tsx scripts/scraper/images/reconcile.ts",
    "catalogue:dupes": "tsx scripts/duplicate-rackets.ts",
    "test:catalogue": "tsx --test scripts/duplicate-rackets.test.ts scripts/racket-release-years.test.ts",
    "rackets:years": "tsx scripts/racket-release-years.ts",
    "strings:images": "tsx scripts/string-images.ts",
    "strings:images:dry": "tsx scripts/string-images.ts --dry-run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.1",
    "next-intl": "^4.13.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cheerio": "^1.2.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
