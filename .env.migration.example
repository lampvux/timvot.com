# Copy this file to .env.migration. Never commit the populated file.
# Use Session pooler URLs (port 5432) unless your network supports the direct
# IPv6 database host. Percent-encode special characters in database passwords.

MIGRATION_SOURCE_DB_URL=postgresql://postgres.SOURCE_REF:SOURCE_PASSWORD@SOURCE_POOLER_HOST:5432/postgres
MIGRATION_TARGET_DB_URL=postgresql://postgres.TARGET_REF:TARGET_PASSWORD@TARGET_POOLER_HOST:5432/postgres

MIGRATION_SOURCE_URL=https://SOURCE_REF.supabase.co
MIGRATION_TARGET_URL=https://TARGET_REF.supabase.co

# Source and target secret/service_role keys from each project's API settings.
# These are used only to copy Storage objects and verify bucket inventories.
MIGRATION_SOURCE_SERVICE_ROLE_KEY=
MIGRATION_TARGET_SERVICE_ROLE_KEY=

# Optional. Range: 1-20; reduce this if Storage starts rate-limiting transfers.
MIGRATION_STORAGE_CONCURRENCY=4

